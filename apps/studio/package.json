{
  "name": "dbos-flow-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:service": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "npm run build:ontology && tsc --noEmit && next build",
    "test": "vitest run",
    "test:integration": "STUDIO_INTEGRATION=1 vitest run server/runtime.integration.test.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "build:ontology": "node scripts/build-ontology.mjs",
    "harness2:setup": "uv sync --project server/harness2 --python 3.12 --frozen",
    "harness2:executor:setup": "uv run --project server/harness2 --frozen python server/harness2/setup.py",
    "harness2:check": "uv run --project server/harness2 --frozen python server/harness2/check.py --output .studio/harness2/upstream-check",
    "build:tools-cli": "node scripts/build-tools-cli.mjs",
    "postinstall": "node scripts/prepare-memory-vendor.mjs",
    "memory:setup": "uv venv --allow-existing .studio/embeddinggemma-runtime-venv --python 3.12 && uv pip sync --python .studio/embeddinggemma-runtime-venv/bin/python scripts/memory-embeddings/requirements.txt && .studio/embeddinggemma-runtime-venv/bin/python scripts/memory-embeddings/runtime.py download",
    "memory:serve": ".studio/embeddinggemma-runtime-venv/bin/python scripts/memory-embeddings/runtime.py serve",
    "memory:benchmark": ".studio/embeddinggemma-runtime-venv/bin/python scripts/memory-embeddings/runtime.py benchmark"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dbos-inc/dbos-sdk": "file:../..",
    "@dbos-inc/node-pg-datasource": "file:../../packages/nodepg-datasource",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@lingui/core": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.23",
    "ai": "^7.0.146",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "framer-motion": "^12.29.2",
    "input-otp": "^1.5.0",
    "jsdom": "^26.1.0",
    "jsep": "1.6.0",
    "lucide-react": "^0.553.0",
    "mem0ai": "3.3.1",
    "next": "^16.0.1",
    "pg": "^8.16.3",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.7",
    "react-stately": "^3.51.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-react-aria-components": "^2.2.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.3.8",
    "typescript": "5.9.3",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "postcss": "^8.5.30",
    "tsx": "^4.20.6",
    "vitest": "^4.1.10"
  }
}

{
  "name": "dbos-flow-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:service": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "build": "tsc --noEmit && next build",
    "test": "vitest run",
    "test:integration": "STUDIO_INTEGRATION=1 vitest run server/runtime.integration.test.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dbos-inc/dbos-sdk": "file:../..",
    "@dbos-inc/node-pg-datasource": "file:../../packages/nodepg-datasource",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@lingui/core": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@untitledui/icons": "^0.0.23",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "jsep": "1.6.0",
    "lucide-react": "^0.553.0",
    "next": "^16.0.1",
    "pg": "^8.16.3",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-stately": "^3.51.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.3.8",
    "typescript": "5.9.3",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.10"
  }
}

# Local development database provided by docker compose.
STUDIO_DATABASE_URL=postgresql://postgres:dbos@127.0.0.1:55432/studio
DBOS_SYSTEM_DATABASE_URL=postgresql://postgres:dbos@127.0.0.1:55432/studio_dbos
# Optional trusted local module exporting register(registry).
# STUDIO_ADAPTER_MODULE=./adapters/my-domain.ts

# Enterprise authentication adapter (exports default or adapter: AuthAdapter).
# Development identity is loopback-only and is disabled by NODE_ENV=production.
# STUDIO_AUTH_MODE=external
# STUDIO_AUTH_ADAPTER_MODULE=./adapters/enterprise-auth.ts
# Required with external authentication: 32 random bytes encoded as base64.
# STUDIO_CREDENTIAL_KEY=<provide through deployment secret storage>
# Optional temporary AWS STS credential resolver (exports default or resolver).
# STUDIO_CREDENTIAL_RESOLVER_MODULE=./adapters/aws-sts.ts

# Optional exact browser origins for an authenticated private preview proxy.
# The API remains bound to loopback; this does not replace authentication.
# STUDIO_ALLOWED_ORIGINS=https://your-machine.your-tailnet.ts.net

# Local semantic memory with Apache-2.0 EmbeddingGemma 2 (no external key or Ollama).
# Provision once: npm run memory:setup
# Run separately: npm run memory:serve (add -- --device mps for Apple GPU)
# Select embeddinggemma after provisioning; model revision and vector space are pinned.
# STUDIO_MEMORY_EMBEDDINGS_PROVIDER=none
# STUDIO_MEMORY_EMBEDDINGS_PROVIDER=embeddinggemma
# STUDIO_MEMORY_EMBEDDINGGEMMA_URL=http://127.0.0.1:11435
# Optional legacy provider: ollama; used only when explicitly selected, or via the old
# opt-in below when STUDIO_MEMORY_EMBEDDINGS_PROVIDER is unset. Never an automatic fallback.
# STUDIO_MEMORY_LOCAL_EMBEDDINGS=1
# STUDIO_MEMORY_OLLAMA_URL=http://127.0.0.1:11434

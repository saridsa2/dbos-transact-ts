# Local development database provided by docker compose.
STUDIO_DATABASE_URL=postgresql://postgres:dbos@127.0.0.1:55432/studio
DBOS_SYSTEM_DATABASE_URL=postgresql://postgres:dbos@127.0.0.1:55432/studio_dbos
# Optional trusted local module exporting register(registry).
# STUDIO_ADAPTER_MODULE=./adapters/my-domain.ts

# Enterprise authentication adapter (exports default or adapter: AuthAdapter).
# Development identity is loopback-only and is disabled by NODE_ENV=production.
# STUDIO_AUTH_MODE=external
# STUDIO_AUTH_ADAPTER_MODULE=./adapters/enterprise-auth.ts
# Required with external authentication: 32 random bytes encoded as base64.
# STUDIO_CREDENTIAL_KEY=<provide through deployment secret storage>
# Optional temporary AWS STS credential resolver (exports default or resolver).
# STUDIO_CREDENTIAL_RESOLVER_MODULE=./adapters/aws-sts.ts
